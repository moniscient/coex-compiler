# Test JSON append without UI
func main() -> int
    print("Testing JSON append...")

    # Build array dynamically
    arr: json := []
    print("Created empty array")

    arr = arr.append(1)
    print("Appended 1")

    arr = arr.append(2)
    print("Appended 2")

    print("Array length: ")
    print(arr.len())

    print("Done!")
    return 0
