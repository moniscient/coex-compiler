# Heapwatch - Real-time Heap Monitoring Library
#
# Provides GC statistics for monitoring heap health.
# Call render(frame) with frame number for console output.
# Call get_panel() to get a JSON layout for embedding in your UI.

extern coex_gc_get_total_allocations() -> int ~
extern coex_gc_get_total_bytes() -> int ~
extern coex_gc_get_collections() -> int ~
extern coex_gc_get_live_objects() -> int ~
extern coex_gc_get_swept_objects() -> int ~
extern coex_gc_get_next_handle() -> int ~
extern coex_gc_get_handle_table_size() -> int ~
extern coex_gc_get_tlabs_reclaimed() -> int ~

# Print heapwatch stats to console
func render(frame: int) -> int
    # Only print every 1000 frames to avoid spam
    if frame % 1000 != 0
        return 1
    ~

    total_allocs = coex_gc_get_total_allocations()
    total_bytes = coex_gc_get_total_bytes()
    collections = coex_gc_get_collections()
    live = coex_gc_get_live_objects()
    next_handle = coex_gc_get_next_handle()
    table_size = coex_gc_get_handle_table_size()
    tlabs_reclaimed = coex_gc_get_tlabs_reclaimed()

    # Calculate bytes in MB
    bytes_mb = total_bytes / 1048576

    # Build strings for output
    allocs_str = String.from(total_allocs)
    bytes_str = String.from(bytes_mb)
    gc_str = String.from(collections)
    live_str = String.from(live)
    next_str = String.from(next_handle)
    size_str = String.from(table_size)
    tlab_str = String.from(tlabs_reclaimed)

    print("[HEAPWATCH] Allocs: " + allocs_str + " | Bytes MB: " + bytes_str + " | GCs: " + gc_str)
    print("[HEAPWATCH] Live: " + live_str + " | Handles: " + next_str + "/" + size_str + " | TLABs: " + tlab_str)

    return 1
~
