# FFI Declarations - Buffers
# =============================================================================

extern coex_bgfx_create_vertex_buffer(vertices_json: string) -> int ~
extern coex_bgfx_create_index_buffer(indices_json: string) -> int ~
extern coex_bgfx_alloc_transient_vertex_buffer(num_vertices: int, layout_json: string) -> int ~
extern coex_bgfx_alloc_transient_index_buffer(num_indices: int, is_32bit: int) -> int ~
extern coex_bgfx_destroy_vertex_buffer(handle: int) -> int ~
extern coex_bgfx_destroy_index_buffer(handle: int) -> int ~

# =============================================================================
