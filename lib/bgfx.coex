# Coex bgfx Library Module
#
# Cross-platform 3D rendering via bgfx (Metal/Vulkan/OpenGL/D3D).
# Requires `import ui` for windowing (bgfx renders into the UI shell window).
#
# Usage:
#   import ui
#   import bgfx
#
#   func main() -> int
#       ui.initialize({title: "3D App", width: 800, height: 600})
#       bgfx.initialize(800, 600)
#       bgfx.set_debug(4)  # show stats
#
#       bgfx.set_view_rect(0, 0, 0, 800, 600)
#       bgfx.set_view_clear(0, 3, 0x303030ff, 1.0, 0)
#
#       while not ui.should_close()
#           bgfx.touch(0)
#           bgfx.dbg_text_clear()
#           bgfx.dbg_text(0, 1, 0x0f, "bgfx + Coex")
#           bgfx.frame()
#       ~
#
#       bgfx.shutdown()
#       ui.close()
#       return 0
#   ~

# =============================================================================
# FFI Declarations - Lifecycle
# =============================================================================

extern coex_bgfx_init(width: int, height: int) -> int ~
extern coex_bgfx_shutdown() -> int ~
extern coex_bgfx_reset(width: int, height: int, flags: int) -> int ~
extern coex_bgfx_frame() -> int ~

# =============================================================================
# FFI Declarations - Views
# =============================================================================

extern coex_bgfx_set_view_rect(view_id: int, x: int, y: int, width: int, height: int) -> int ~
extern coex_bgfx_set_view_clear(view_id: int, flags: int, rgba: int, depth: float, stencil: int) -> int ~
extern coex_bgfx_set_view_transform(view_id: int, view_json: string, proj_json: string) -> int ~
extern coex_bgfx_touch(view_id: int) -> int ~

