extern coex_bgfx_set_transient_vertex_buffer(stream: int, handle: int, start_vertex: int, num_vertices: int) -> int ~
extern coex_bgfx_set_index_buffer(handle: int, first_index: int, num_indices: int) -> int ~
extern coex_bgfx_set_transient_index_buffer(handle: int, first_index: int, num_indices: int) -> int ~
extern coex_bgfx_set_texture(stage: int, uniform_handle: int, texture_handle: int, flags: int) -> int ~
