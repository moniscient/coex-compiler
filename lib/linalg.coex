# Linear algebra module for Coex standard library
#
# Provides matrix operations for Array<T> types:
# - matmul_gpu(a, b) - GPU-accelerated matrix multiplication via Metal (recommended)
# - matmul_f64(a, b) - CPU matrix multiplication via BLAS (64-bit)
# - matmul_f32(a, b) - CPU matrix multiplication via BLAS (32-bit)
# - dot(a, b) - Dot product of 1D arrays
#
# On macOS:
#   - GPU: Metal Performance Shaders (MPSMatrixMultiplication) - ~7-8 TFLOPS
#   - CPU: Apple Accelerate framework (AMX coprocessor) - ~2-3 TFLOPS
#
# On Linux, OpenBLAS is used for CPU operations.
# Falls back to pure Coex implementation if no acceleration is available.
#
# Note: These use 'func' instead of 'formula' because they need FFI calls.

# ========================================================================
# FFI declarations for GPU matmul (Metal Performance Shaders)
# ========================================================================

extern coex_metal_matmul(a: Array<float>, b: Array<float>) -> Array<float> ~

# ========================================================================
# FFI declarations for CPU BLAS wrappers
# ========================================================================

extern coex_linalg_matmul(a: Array<float>, b: Array<float>) -> Array<float> ~
extern coex_linalg_matmul32(a: Array<float>, b: Array<float>) -> Array<float> ~
extern coex_linalg_dot(x: Array<float>, y: Array<float>) -> float ~
extern coex_linalg_norm(x: Array<float>) -> float ~

# ========================================================================
# GPU-accelerated operations (recommended for best performance)
# ========================================================================

# Matrix multiplication using GPU (Metal Performance Shaders)
# Achieves ~7-8 TFLOPS on M1 Max (vs ~2-3 TFLOPS for CPU BLAS)
# A is m x k, B is k x n, result is m x n
func matmul_gpu(_ a: Array<float>, _ b: Array<float>) -> Array<float>
    return coex_metal_matmul(a, b)
~

# ========================================================================
# CPU BLAS-backed operations (fallback or when GPU unavailable)
# ========================================================================

# Matrix multiplication using CPU BLAS (64-bit precision)
# Uses Apple Accelerate AMX on macOS, OpenBLAS on Linux
func matmul_f64(_ a: Array<float>, _ b: Array<float>) -> Array<float>
    return coex_linalg_matmul(a, b)
~

# Matrix multiplication using CPU BLAS (32-bit precision)
# Slightly faster than f64 on CPU due to smaller data size
func matmul_f32(_ a: Array<float>, _ b: Array<float>) -> Array<float>
    return coex_linalg_matmul32(a, b)
~

# Dot product using BLAS
func dot_f64(_ x: Array<float>, _ y: Array<float>) -> float
    return coex_linalg_dot(x, y)
~

# Euclidean norm using BLAS
func norm_f64(_ x: Array<float>) -> float
    return coex_linalg_norm(x)
~

# ========================================================================
# Pure Coex implementations (int arrays, fallback)
# ========================================================================

# Dot product of two 1D arrays
func dot(_ a: Array<int>, _ b: Array<int>) -> int
    n: int = a.len()
    sum: int = 0
    i: int = 0
    while i < n
        sum = sum + a.get(i) * b.get(i)
        i = i + 1
    ~
    return sum
~

# Matrix-vector multiplication: y = A * x
# A is m x n, x is length n, result is length m
func matvec(_ a: Array<int>, _ x: Array<int>) -> Array<int>
    m: int = a.shape(0)
    n: int = a.shape(1)

    result: Array<int> = Array.zeros(m)

    i: int = 0
    while i < m
        sum: int = 0
        j: int = 0
        while j < n
            sum = sum + a[i, j] * x.get(j)
            j = j + 1
        ~
        result = result.set(i, sum)
        i = i + 1
    ~
    return result
~

# Matrix multiplication: C = A * B
# A is m x k, B is k x n, result is m x n
func matmul(_ a: Array<int>, _ b: Array<int>) -> Array<int>
    m: int = a.shape(0)
    k: int = a.shape(1)
    n: int = b.shape(1)

    result: Array<int> = Array.zeros_2d(m, n)

    i: int = 0
    while i < m
        j: int = 0
        while j < n
            sum: int = 0
            p: int = 0
            while p < k
                sum = sum + a[i, p] * b[p, j]
                p = p + 1
            ~
            # Set result[i, j] = sum using flatten/set/reshape
            idx: int = i * n + j
            flat: Array<int> = result.flatten()
            flat = flat.set(idx, sum)
            result = flat.reshape(m, n)
            j = j + 1
        ~
        i = i + 1
    ~
    return result
~
