#@ [MOVE] Variable 'start' is not used after this assignment. Consider: num := start (move instead of copy)
#@ [MOVE] Variable 'first_mult' is not used after this assignment. Consider: mult := first_mult (move instead of copy)
#@ [PERF] Loop modifies 'task_indices' with append on each iteration, creating intermediate lists. Consider using Array for in-place mutation.
# Mini parallel sieve - smaller scale to test the algorithm pattern

thread sieve_segment(segment_idx: int, start: int, end_val: int, small_primes: [int]) -> int
    # Mark composites in this segment
    composites: Set<int> = {}

    idx = 0
    while idx < small_primes.len()
        p = small_primes.get(idx)

        # Find first multiple of p >= start
        first_mult = 0
        if start <= p * p
            first_mult = p * p
        else
            remainder = start % p
            if remainder == 0
                first_mult = start
            else
                first_mult = start + (p - remainder)
            ~
        ~

        # Mark all multiples of p in this segment
        mult = first_mult
        while mult < end_val
            composites = composites.add(mult)
            mult = mult + p
        ~

        idx = idx + 1
    ~

    # Count primes in this segment
    prime_count = 0
    num = start
    if num < 2
        num = 2
    ~
    while num < end_val
        if not composites.has(num)
            prime_count = prime_count + 1
        ~
        num = num + 1
    ~

    return prime_count
~

func find_small_primes(limit: int) -> [int]
    composites: Set<int> = {}

    i = 2
    while i * i <= limit
        if not composites.has(i)
            j = i * i
            while j <= limit
                composites = composites.add(j)
                j = j + i
            ~
        ~
        i = i + 1
    ~

    primes: [int] = []
    k = 2
    while k <= limit
        if not composites.has(k)
            primes = primes.append(k)
        ~
        k = k + 1
    ~

    return primes
~

func main() -> int
    print("=== Mini Parallel Sieve Test ===")
    print("Finding primes up to 100,000 using 4 parallel tasks")
    print("")

    const LIMIT = 100000
    const NUM_TASKS = 4
    const SQRT_LIMIT = 316
    const SEGMENT_SIZE = LIMIT / NUM_TASKS

    print("Step 1: Finding small primes...")
    small_primes = find_small_primes(SQRT_LIMIT)
    print("  Found small primes: ")
    print(small_primes.len())

    print("")
    print("Initial GC stats:")
    gc_dump_stats()
    print("")

    print("Step 2: Preparing segments...")
    task_indices: [int] = []
    for i in 0..NUM_TASKS
        task_indices = task_indices.append(i)
    ~

    print("Step 3: Spawning parallel tasks...")
    results = for idx in task_indices sieve_segment(idx, idx * SEGMENT_SIZE, (idx + 1) * SEGMENT_SIZE, small_primes) ~

    print("Step 4: Collecting results...")
    total_primes = 0
    for r in results
        total_primes = total_primes + r
    ~

    print("Total primes found: ")
    print(total_primes)
    print("")
    print("Expected: 9592")
    print("")

    print("Final GC stats:")
    gc_dump_stats()

    return 0
~
