#@ [PERF] Loop modifies 'task_indices' with append on each iteration, creating intermediate lists. Consider using Array for in-place mutation.
# Larger parallel HAMT test to trigger automatic GC during parallel execution

thread build_large_set(n: int) -> int
    s: Set<int> = {}
    i = 0
    while i < n
        s = s.add(i)
        i = i + 1
    ~
    return s.len()
~

func main() -> int
    print("=== Parallel Large HAMT Test ===")
    print("Building 4 sets of 10000 elements each to trigger automatic GC")
    print("")

    print("Before parallel tasks:")
    gc_dump_stats()
    print("")

    # Create 4 tasks that each build a set of 10000 elements
    print("Spawning 4 parallel tasks (each builds a Set with 10000 elements)...")
    task_indices: [int] = []
    for i in 0..4
        task_indices = task_indices.append(i)
    ~

    results = for idx in task_indices build_large_set(10000) ~

    print("Tasks completed!")
    total = 0
    for r in results
        total = total + r
    ~
    print("Total elements: ")
    print(total)
    print("")

    print("After parallel tasks:")
    gc_dump_stats()

    return 0
~
