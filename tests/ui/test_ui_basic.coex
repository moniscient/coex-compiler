# Basic UI test - verify module imports and basic UI functions
# Note: ui.close() causes a segfault during shutdown (BUG-050)
import ui

func main() -> int
    print("Testing UI module...")

    # Initialize the UI library
    config = "{\"title\": \"Test Window\", \"width\": 400, \"height\": 300}"
    result = ui.initialize(config)
    print("ui.initialize returned:")
    print(result)

    if result == 1
        print("UI initialized successfully")

        # Check if window should close (should be false initially)
        should_close = ui.should_close()
        print("should_close:")
        print(should_close)

        # Get time since init
        time = ui.get_time()
        print("time:")
        print(time)

        # Test the render function with a simple layout
        layout = "{\"type\": \"window\", \"title\": \"Test\", \"children\": [{\"type\": \"text\", \"text\": \"Hello\"}]}"
        state = "{}"
        print("Calling ui.render...")
        render_result = ui.render(layout, state)
        print("render result:")
        print(render_result)

        # Skip shutdown due to BUG-050 segfault
        # ui.close()
        print("UI test complete (shutdown skipped - BUG-050)")
    else
        print("UI initialization failed")
    ~

    print("PASSED")
    return 0
